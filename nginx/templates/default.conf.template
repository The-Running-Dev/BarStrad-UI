# ====================================================================
# NGINX SITE CONFIGURATION FOR BarStrad-UI
# ====================================================================
#
# The official nginx image renders this template into
# /etc/nginx/conf.d/default.conf at container start, substituting the
# container's environment variables (${DiscordWebhookUrl},
# ${NGINX_LOCAL_RESOLVERS}).
#
# Order notifications: the browser posts to the same-origin path
# /api/notify and nginx forwards the post to the Discord webhook. The
# webhook URL is a credential (anyone holding it can post to the
# channel), so it lives only in the container's environment and never
# reaches the browser bundle.
#
# ====================================================================

# At most one order a second per client address, with a short burst so
# a table can place several orders in quick succession.
limit_req_zone $binary_remote_addr zone=order_notify:1m rate=60r/m;

# Only a Discord webhook URL is ever forwarded to: anything else (unset,
# mistyped, another host) leaves the path empty and /api/notify answers 503.
map "${DiscordWebhookUrl}" $discord_webhook_path {
    "~^https://(?:(?:canary|ptb)\.)?discord(?:app)?\.com(/api/webhooks/[0-9]+/[A-Za-z0-9_-]+)/?$" $1;
    default "";
}

server {
    listen       80;
    server_name  localhost;

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
    }

    location = /api/notify {
        limit_except POST {
            deny all;
        }

        limit_req zone=order_notify burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;

        if ($discord_webhook_path = "") {
            return 503;
        }

        # The browser's cookies and credentials are not Discord's business.
        proxy_set_header Host discord.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";

        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
        proxy_ssl_server_name on;
        proxy_ssl_name discord.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

        proxy_pass https://discord.com$discord_webhook_path;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
